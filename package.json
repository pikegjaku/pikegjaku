{
    "name": "pikegjaku-monorepo",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/shared",
        "www",
        "api"
    ],
    "scripts": {
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write . && eslint . --fix",
        "format:check": "prettier --check . || true",
        "check": "bun run format && bun run lint",
        "app:start": "cd app && RCT_METRO_PORT=2030 expo start --port 2020",
        "app:android": "cd app && RCT_METRO_PORT=2030 expo start --android --port 2020",
        "app:ios": "cd app && RCT_METRO_PORT=2030 expo start --ios --port 2020",
        "app:web": "cd app && RCT_METRO_PORT=2030 expo start --web --port 2020",
        "app:lint": "cd app && expo lint",
        "app:knip": "cd app && knip",
        "app:unimported": "cd app && unimported",
        "app:run:android": "cd app && expo run:android",
        "app:run:ios": "cd app && expo run:ios",
        "app:build:android": "cd app && eas build --platform android --profile production",
        "app:publish:ios": "cd app && expo publish --release-channel ios",
        "app:publish:android": "cd app && expo publish --release-channel android",
        "app:publish:test:ios": "cd app && eas submit -p ios --latest",
        "app:eas:build:android": "cd app && eas build -p android --profile production",
        "app:eas:build:ios": "cd app && eas build -p ios --profile production",
        "app:eas:build:android:dev": "cd app && eas build -p android --profile development",
        "app:eas:build:ios:dev": "cd app && eas build -p ios --profile development",
        "api:dev": "cd api && bun run --hot index.ts",
        "api:build": "cd api && bun build index.ts --outdir dist --target bun",
        "api:start": "cd api && bun run index.ts",
        "api:tsc": "cd api && tsc",
        "api:lint": "cd api && eslint .",
        "api:lint:fix": "cd api && eslint . --fix",
        "api:unimported": "cd api && unimported",
        "api:knip": "cd api && knip",
        "api:seed": "cd api && bun run scripts/seed-countries-cities.ts",
        "www:dev": "cd www && bunx astro dev --port 2010",
        "www:build": "cd www && bunx astro build",
        "www:preview": "cd www && bunx astro preview --port 2010",
        "www:tsc": "cd www && tsc --noEmit",
        "www:lint": "cd www && eslint .",
        "www:lint:fix": "cd www && eslint . --fix",
        "admin:dev": "cd admin && bunx vite dev",
        "admin:build": "cd admin && bunx vite build",
        "admin:preview": "cd admin && bunx vite preview"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "husky": "^9.1.5",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.57.2"
    },
    "dependencies": {
        "@expo/config-plugins": "^55.0.7",
        "zod": "^4.3.6"
    },
    "overrides": {
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-native": "0.83.4"
    }
}
