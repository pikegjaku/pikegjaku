---
import type { LayoutProps } from '@/ts/Interfaces'
import '@/styles/global.css'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'

interface Props extends LayoutProps {}

const { title, description } = Astro.props
const siteUrl = 'https://pikegjaku.com'
const ogImage = '/og-image.webp'
const gaId = import.meta.env.PUBLIC_GA_ID
const hotjarId = import.meta.env.PUBLIC_HOTJAR_ID
const clarityId = import.meta.env.PUBLIC_CLARITY_ID

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        'name': 'Pikëgjaku',
        'url': 'https://pikegjaku.com',
        'logo': 'https://pikegjaku.com/favicon.svg',
        'description': description,
        'areaServed': [
            { '@type': 'Country', 'name': 'Kosovo' },
            { '@type': 'Country', 'name': 'Albania' },
            { '@type': 'Country', 'name': 'North Macedonia' }
        ]
    },
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        'name': 'Pikëgjaku',
        'url': 'https://pikegjaku.com',
        'inLanguage': 'sq'
    },
    {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        'name': 'Pikëgjaku',
        'operatingSystem': 'iOS, Android',
        'applicationCategory': 'HealthApplication',
        'description': description,
        'url': 'https://pikegjaku.com',
        'inLanguage': 'sq',
        'offers': {
            '@type': 'Offer',
            'price': '0',
            'priceCurrency': 'EUR'
        },
        'author': {
            '@type': 'Organization',
            'name': 'Pikëgjaku',
            'url': 'https://pikegjaku.com'
        },
        'image': `${siteUrl}${ogImage}`
    }
]
---

<!doctype html>
<html lang='sq'>
    <head>
        <Head
            title={title}
            description={description}
            themeColor='#000000'
            schema={schema}
        />

        {gaId && (
            <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
            <script define:vars={{ gaId }}>
                window.dataLayer = window.dataLayer || []
                function gtag() { dataLayer.push(arguments) }
                gtag('js', new Date())
                gtag('config', gaId)
            </script>
        )}

        {hotjarId && (
            <script define:vars={{ hotjarId }}>
                (function(h,o,t,j,a,r){
                    h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)}
                    h._hjSettings={hjid:Number(hotjarId),hjsv:6}
                    a=o.getElementsByTagName('head')[0]
                    r=o.createElement('script');r.async=1
                    r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv
                    a.appendChild(r)
                })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=')
            </script>
        )}

        {clarityId && (
            <script define:vars={{ clarityId }}>
                (function(c,l,a,r,i,t,y){
                    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)}
                    t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i
                    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)
                })(window,document,'clarity','script',clarityId)
            </script>
        )}
    </head>
    <body class='home-body'>
        <Header />
        <main>
            <slot />
        </main>
    </body>
</html>

<style>
    .home-body {
        overflow: hidden;
        height: 100dvh;
    }
</style>
