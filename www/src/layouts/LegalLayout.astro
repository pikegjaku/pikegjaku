---
import type { LayoutProps } from '@/ts/Interfaces'
import '@/styles/global.css'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'

interface Props extends LayoutProps {}

const { title, description, noindex = false } = Astro.props
const siteUrl = 'https://pikegjaku.com'
const pageUrl = `${siteUrl}${Astro.url.pathname}`

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        'name': title,
        'description': description,
        'url': pageUrl,
        'inLanguage': 'sq',
        'isPartOf': {
            '@type': 'WebSite',
            'name': 'Pikëgjaku',
            'url': 'https://pikegjaku.com'
        },
        'publisher': {
            '@type': 'Organization',
            'name': 'Pikëgjaku',
            'url': 'https://pikegjaku.com'
        },
        'speakable': {
            '@type': 'SpeakableSpecification',
            'cssSelector': ['.legal-title', '.legal-subtitle', '.legal-sections']
        }
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            {
                '@type': 'ListItem',
                'position': 1,
                'name': 'Pikëgjaku',
                'item': 'https://pikegjaku.com'
            },
            {
                '@type': 'ListItem',
                'position': 2,
                'name': title,
                'item': pageUrl
            }
        ]
    }
]
---

<!doctype html>
<html lang='sq'>
    <head>
        <Head
            title={title}
            description={description}
            themeColor='#fafafa'
            noindex={noindex}
            schema={schema}
        />
    </head>
    <body class='legal-body'>
        <Header variant='light' />
        <main class='legal-content'>
            <slot />
        </main>
    </body>
</html>

<style>
    .legal-body {
        background-color: #fafafa !important;
        color: #1a1a1a !important;
    }

    .legal-content {
        max-width: 680px;
        margin: 0 auto;
        padding: 48px 20px 80px;
    }

    @media (max-width: 640px) {
        .legal-content {
            padding: 32px 16px 60px;
        }
    }
</style>
