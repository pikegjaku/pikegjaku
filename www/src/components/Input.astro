---
import type { InputProps } from '@/ts/Interfaces'

interface Props extends InputProps {}

const { placeholder, type = 'email', name, required = false } = Astro.props
---

<label class='input-label'>
    <span class='sr-only'>{name}</span>
    <div class='input-wrapper'>
        <input
            type={type}
            name={name}
            placeholder={placeholder}
            required={required}
            class='input-field'
        />
    </div>
</label>

<style>
    .input-label {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
    }

    .input-wrapper {
        position: relative;
        width: 100%;
        height: 40px;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .input-field {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        padding: 12px 12px 11px 12px;
        background: var(--color-brand-input-bg);
        border: 1px solid var(--color-brand-input-border);
        font-family: var(--font-family-body);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.2;
        color: white;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-field::placeholder {
        color: var(--color-brand-text-muted);
    }

    .input-field:focus {
        border-color: var(--color-brand-input-focus);
    }

    .input-field:disabled {
        user-select: none;
        pointer-events: none;
        opacity: 0.7;
    }
</style>