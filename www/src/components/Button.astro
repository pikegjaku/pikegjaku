---
import type { ButtonProps } from '@/ts/Interfaces'

interface Props extends ButtonProps {}

const { label, type = 'submit', href } = Astro.props
---

<div>
    {href ? (
        <a href={href} class='btn'>{label}</a>
    ) : (
        <button type={type} class='btn'>{label}</button>
    )}
</div>

<style>
    .btn {
        height: 40px;
        padding: 0 20px;
        border-radius: 12px;
        background-color: var(--color-brand-red);
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: white;
        border: none;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color 0.2s, border 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
    }

    .btn:hover {
        background-color: var(--color-brand-red-hover);
    }

    .btn:disabled {
        cursor: not-allowed;
        opacity: 0.85;
    }


    :global(.spinner) {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

</style>
