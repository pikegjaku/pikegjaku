---
import type { NotFoundProps } from '@/ts/Interfaces'
import Icon from '@/components/Icon.astro'
import Button from '@/components/Button.astro'

interface Props extends NotFoundProps {}

const { title, description, backLabel } = Astro.props
---

<div class='not-found'>
    <div class='not-found-icon'>
        <Icon name='warning-circle' size={48} />
    </div>
    <h1>{title}</h1>
    <p>{description}</p>
    <Button label={backLabel} href='/' />
</div>

<style>
    .not-found {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: calc(100vh - 200px);
        gap: 12px;
        animation: fadeIn 0.6s ease-out both;
        padding: 0 20px;
    }

    .not-found-icon {
        color: #ccc;
        margin-bottom: 4px;
    }

    .not-found h1 {
        font-family: 'Host Grotesk', sans-serif;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: -0.03em;
        line-height: 1.1em;
        color: #1a1a1a;
        margin: 0;
    }

    .not-found p {
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.6em;
        color: #999;
        margin: 0;
        max-width: 380px;
    }

    @media (max-width: 640px) {
        .not-found h1 {
            font-size: 26px;
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
