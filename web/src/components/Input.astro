---
import type { InputProps } from '@/ts/Interfaces'

interface Props extends InputProps {}

const { placeholder, type = 'email', name, required = false } = Astro.props
---

<label class='input-label'>
    <span class='sr-only'>{name}</span>
    <div class='input-wrapper'>
        <input
            type={type}
            name={name}
            placeholder={placeholder}
            required={required}
            class='input-field'
        />
        <svg
            class='input-lock'
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 256 256'
            fill='currentColor'
            aria-hidden='true'
        >
            <path d='M208,80H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Zm-68-56a12,12,0,1,1-12-12A12,12,0,0,1,140,152Z'/>
        </svg>
    </div>
</label>

<style>
    .input-label {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
    }

    .input-wrapper {
        position: relative;
        width: 100%;
        height: 40px;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .input-field {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        padding: 12px 12px 11px 12px;
        background: var(--color-brand-input-bg);
        border: 1px solid var(--color-brand-input-border);
        font-family: var(--font-family-body);
        font-size: 16px;
        font-weight: 400;
        line-height: 1.2;
        color: white;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-field::placeholder {
        color: rgba(255, 255, 255, 0.4);
        font-weight: 300;
    }

    .input-field:focus {
        border-color: var(--color-brand-input-focus);
    }

    .input-field:disabled {
        user-select: none;
        pointer-events: none;
        opacity: 0.7;
    }

    .input-field-error,
    .input-field-error:focus {
        border-color: var(--color-brand-red);
    }

    .input-field-locked,
    .input-field-locked:focus {
        cursor: default;
        pointer-events: none;
        padding-right: 36px;
        color: var(--color-brand-text-muted);
        border-color: var(--color-brand-input-border);
    }

    .input-lock {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        color: var(--color-brand-text-muted);
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
    }

    .input-lock-visible {
        opacity: 1;
    }
</style>