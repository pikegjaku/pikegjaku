---
import type { LegalPageProps } from '@/ts/Interfaces'

interface Props extends LegalPageProps {}

const { title, subtitle, sections } = Astro.props
---

<div class='legal-page'>
    <h1 class='legal-title'>{title}</h1>
    <p class='legal-subtitle'>{subtitle}</p>

    <div class='legal-sections'>
        {sections.map((section) => (
            <section>
                <h2>{section.title}</h2>
                <p>{section.content}</p>
            </section>
        ))}
    </div>
</div>

<style>
    .legal-page {
        animation: fadeIn 0.6s ease-out both;
    }

    .legal-title {
        font-family: 'Host Grotesk', sans-serif;
        font-size: 36px;
        font-weight: 400;
        letter-spacing: -0.03em;
        line-height: 1.1em;
        color: #1a1a1a;
        margin: 0 0 12px;
    }

    .legal-subtitle {
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.6em;
        color: #999;
        margin: 0 0 40px;
        padding-bottom: 40px;
        border-bottom: 1px solid #eee;
    }

    .legal-sections {
        display: flex;
        flex-direction: column;
        gap: 36px;
    }

    .legal-sections section {
        padding: 0;
    }

    .legal-sections h2 {
        font-family: 'Host Grotesk', sans-serif;
        font-size: 20px;
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.2em;
        color: #1a1a1a;
        margin: 0 0 10px;
    }

    .legal-sections p {
        font-family: 'DM Sans', sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.7em;
        color: #666;
        margin: 0;
    }

    @media (max-width: 640px) {
        .legal-title {
            font-size: 28px;
        }

        .legal-sections {
            gap: 28px;
        }

        .legal-sections h2 {
            font-size: 18px;
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
