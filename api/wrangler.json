{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "pikegjaku-api",
    "main": "index.ts",
    "compatibility_date": "2026-10-01",
    "minify": true,
    "upload_source_maps": true,
    "routes": [
        {
            "pattern": "api.pikegjaku.com",
            "custom_domain": true
        }
    ],
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": true
    },
    "dev": {
        "ip": "0.0.0.0",
        "port": 1111,
        "generate_types": true
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["Server"]
        },
        {
            "tag": "v2",
            "deleted_classes": ["Server"]
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "pikegjaku",
            "database_id": "cb5e4395-4840-46e8-802c-251d30ff737a",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "CDN",
            "bucket_name": "pikegjaku-cdn",
            "jurisdiction": "eu"
        }
    ],
    "images": {
        "binding": "IMAGES"
    },
    "secrets": {
        "required": [
            "AUTH_ACCESS_TOKEN_SECRET",
            "AUTH_REFRESH_TOKEN_SECRET",
            "ENV",
            "OPENEMAIL_ADMIN",
            "OPENEMAIL_API_KEY",
            "OPENEMAIL_FROM",
            "ORIGINS",
            "SENT_API_KEY",
            "SENT_TEMPLATE_ID"
        ]
    }
}
